# next.js
.next/
out/
# Anchored to the repo root. Unanchored, `build` matches a directory of that
# name at ANY depth — which silently excluded lib/build/ and app/api/build/,
# two directories of source. `git add -A` skipped them without a word and the
# deploy failed with module-not-found on a build that worked locally.
/build
/dist
/dist-ssr

