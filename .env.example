# ==========================================================================
# PageFly Design — environment
#
# Copy to .env.local for development. On Vercel, set these in
# Project → Settings → Environment Variables.
#
# Nothing here has a working default in production: the two REQUIRED variables
# below fail loudly rather than falling back, because a fallback secret in a
# public repository is the same as no secret at all.
# ==========================================================================

# ---- REQUIRED -------------------------------------------------------------

# Signs the session cookies. Generate with:  openssl rand -base64 32
#
# Not required to get running. Without it:
#   - on serverless, the key is derived from the platform's project identifiers,
#     which every instance of the deployment shares, so sessions work
#   - elsewhere, a random key is generated and written next to the data store
#
# Set it anyway before this is public: a derived key can be recomputed by anyone
# with access to the Vercel project, and only a real secret survives moving hosts.
SESSION_SECRET=

# Postgres. Vercel Postgres, Neon and Supabase all work unchanged — it is the
# same protocol. Vercel's own integration sets POSTGRES_URL for you, which is
# also read.
DATABASE_URL=

# ---- OR: run without Postgres, on ONE server ------------------------------
# Set PFD_STORE=file to keep everything in a JSON file instead. Correct on a
# single-instance VPS with a persistent disk, and the fastest way to get running.
#
# NEVER set this on Vercel or behind more than one process: serverless instances
# neither share a disk nor keep one, so each would answer from its own copy and
# merchants would watch their library appear and disappear.
#
# PFD_STORE=file
# PFD_DB_FILE=/var/lib/pagefly-design/store.json

# ---- ALLOWLIST SHEET ------------------------------------------------------
# Pick ONE of the three. The sheet holds merchant email addresses, so option 2
# is the least private of them — see lib/sheet.ts.

# 1. Service account (recommended). Create one in Google Cloud, enable the
#    Sheets API, then share the sheet with the service account's email as
#    Viewer. Paste the whole JSON key on one line.
SHEET_SERVICE_ACCOUNT_JSON=

# 2. Any URL that returns CSV, including File > Share > Publish to web.
#    WARNING: publishing that sheet exposes every merchant email to anyone with
#    the link. Prefer option 1 or 3 for the real list.
ALLOWLIST_SHEET_CSV_URL=

# 3. Push model — n8n reads the sheet with your existing Google credential and
#    POSTs the rows to /api/admin/sync with this value in an x-sync-secret
#    header. No Google credentials on our side at all.
SYNC_SECRET=

# 4. Or none of the above: sign in to /design/admin → Users → "Paste the sheet
#    instead", and paste the rows straight out of Google Sheets. Nothing to
#    configure, and the sheet stays private.

# Which sheet and tab to read (only used by options 1 and 2).
ALLOWLIST_SHEET_ID=13gh6ymdVQLzeQARArytZWqWmNA6uAd4Si_kaum1fOcw
ALLOWLIST_SHEET_TAB=User Beta

# Page allowance for a store whose "Số page" cell is empty or unparseable.
DEFAULT_PAGE_LIMIT=30

# ---- REVIEWS --------------------------------------------------------------

# The n8n webhook that writes the star rating into the sheet. Reviews are saved
# to the database first and forwarded second, so leaving this unset loses
# nothing: rows stay with forwarded = false and can be replayed later.
REVIEW_WEBHOOK_URL=

# Optional. Sent as x-webhook-secret so the n8n workflow can reject anything
# that is not us.
REVIEW_WEBHOOK_SECRET=

# ---- ADMIN ----------------------------------------------------------------

# Defaults to admin / pf123456 — the pair specified for launch. Both are weak
# and shared; override them before anyone outside the team can reach
# /design/admin. Compared server-side only, so they never reach the browser.
ADMIN_USERNAME=
ADMIN_PASSWORD=
